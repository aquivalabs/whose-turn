#!/usr/bin/env bash
set -e
refs=$(cat)
# docs/adr/0007-release-pipeline.md, amendment RMA-328
if printf '%s\n' "$refs" | awk '$3 == "refs/heads/release" { found = 1 } END { exit !found }'; then
  node scripts/skill-knows-release.mjs
fi
# Window gate: types, lint, style lint and the test suite in one command (frontend-vue:tooling).
npm run check
# AGENTS.md § Gates, "Docs follow the docs standard"
node scripts/docs-check.mjs
# AGENTS.md § Gates, "/review on every pull request", RMA-207
scope=
if printf '%s\n' "$refs" | awk '$3 == "refs/heads/release" { found = 1 } END { exit !found }' &&
  printf '%s\n' "$refs" | awk '{ print $2 }' | xargs -n1 -I{} git merge-base --is-ancestor {} origin/main; then
  scope=--secrets-only
fi
printf '%s\n' "$refs" | npx -y -p bladeforge-review-harness@0.3.1 review-gate $scope
