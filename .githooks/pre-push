#!/usr/bin/env bash
set -e
# Window gate: types, lint, style lint and the test suite in one command (frontend-vue:tooling).
npm run check
# Docs gate — blocks a push that leaves a declared mechanism's doc behind.
# Ignores the ref pairs git passes on stdin: a per-push range would fail a rule the PR satisfies.
node scripts/docs-check.mjs
# Secret scan on every push. The full review gate (a fresh /review attestation) is off during the alpha
# and runs once at the end of a working day instead; AGENTS.md "Gates", RMA-206. RMA-207 turns it back on per PR.
npx -y -p bladeforge-review-harness@0.3.1 review-gate --secrets-only
