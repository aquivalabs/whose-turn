{
  "port": 8765,
  "poll_seconds": 60,
  "history_days": 14,
  "workspaces": [
    {
      "id": "work",
      "name": "Work",
      "key_pattern": "\\bPROJ-\\d+\\b",
      "connectors": {
        "github": {
          "repo": "your-org/your-repo",
          "org": "your-org",
          "me": "",
          "account": "",
          "bots": [
            "github-actions",
            "dependabot",
            "[bot]"
          ]
        },
        "jira": {
          "base": "https://your-site.atlassian.net",
          "email": "you@example.com",
          "token_service": "whose-turn-jira",
          "jql": "(assignee = currentUser() AND statusCategory != Done) OR (assignee was currentUser() AND updated >= -30d) ORDER BY updated DESC"
        }
      },
      "rules": {
        "release_branch_prefix": "release/",
        "approved_next": "Merge it",
        "approved_release_next": "Hand over to QA",
        "passed_next": "Merge it and close the ticket",
        "merged_next": "Close the ticket",
        "statuses": {
          "passed": [
            "passed"
          ],
          "code_review": [
            "code review",
            "in review"
          ],
          "qa": [
            "ready for qa",
            "in qa",
            "testing"
          ],
          "on_hold": [
            "on hold",
            "blocked"
          ],
          "backlog": [
            "backlog"
          ]
        },
        "automation_authors": [
          "automation"
        ]
      }
    },
    {
      "id": "personal",
      "name": "Personal",
      "theme": {
        "seed": "#3d7a5c",
        "accent": "#c27a2c"
      },
      "connectors": {
        "github": {
          "repo": "you/your-project"
        }
      }
    },
    {
      "id": "demo",
      "name": "Demo",
      "key_pattern": "\\bNW-\\d+\\b",
      "theme": {
        "seed": "#3d7a5c",
        "accent": "#c27a2c"
      },
      "connectors": [
        {
          "type": "demo",
          "scenario": "northwind",
          "label": "Demo tracker"
        }
      ]
    }
  ]
}
