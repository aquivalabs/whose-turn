{
  "port": 8765,
  "poll_seconds": 60,
  "history_days": 14,
  "stale_minutes": 15,
  "failing_polls": 3,
  "workspaces": [
    {
      "id": "work",
      "name": "Work",
      "key_pattern": "\\bPROJ-\\d+\\b",
      "connectors": {
        "github": {
          "repo": "your-org/your-repo",
          "org": "your-org",
          "me": "",
          "account": "",
          "bots": [
            "github-actions",
            "dependabot",
            "[bot]"
          ]
        },
        "jira": {
          "base": "https://your-site.atlassian.net",
          "email": "you@example.com",
          "token_service": "whose-turn-jira",
          "jql": "(assignee = currentUser() AND statusCategory != Done) OR (assignee was currentUser() AND updated >= -30d) ORDER BY updated DESC"
        }
      },
      "rules": {
        "release_branch_prefix": "release/",
        "approved_next": "Merge it",
        "approved_release_next": "Hand over to QA",
        "passed_next": "Merge it and close the ticket",
        "merged_next": "Close the ticket",
        "statuses": {
          "passed": [
            "passed"
          ],
          "code_review": [
            "code review",
            "in review"
          ],
          "qa": [
            "ready for qa",
            "in qa",
            "testing"
          ],
          "on_hold": [
            "on hold",
            "blocked"
          ],
          "backlog": [
            "backlog"
          ]
        },
        "automation_authors": [
          "automation"
        ],
        "table": [
          {
            "when": {
              "unanswered_count": {
                "gte": 2
              }
            },
            "then": {
              "whose": "you",
              "next": "Answer {comment.author} and the others on {ticket.key}",
              "why": "{unanswered_count} @-mentions of you wait for a reply."
            }
          },
          {
            "when": {
              "pr.open": true,
              "pr.base": {
                "prefix": "release/"
              },
              "pr.checks": [
                "running",
                "none"
              ]
            },
            "then": {
              "whose": "them",
              "next": "Wait for the release checks on PR #{pr.number}"
            }
          },
          "default"
        ]
      }
    },
    {
      "id": "personal",
      "name": "Personal",
      "theme": {
        "seed": "#3d7a5c",
        "accent": "#c27a2c"
      },
      "connectors": {
        "github": {
          "repo": "you/your-project"
        },
        "linear": {
          "workspace": "your-space",
          "team": "PROJ"
        }
      }
    },
    {
      "id": "demo",
      "name": "Demo",
      "key_pattern": "\\bNW-\\d+\\b",
      "theme": {
        "seed": "#3d7a5c",
        "accent": "#c27a2c"
      },
      "connectors": [
        {
          "type": "demo",
          "scenario": "northwind",
          "label": "Demo tracker"
        }
      ]
    }
  ],
  "feedback": {
    "workspace": "your-space",
    "team": "PROJ",
    "project": "monitor",
    "token_service": "whose-turn-feedback",
    "composer": {
      "command": "claude",
      "args": [
        "-p",
        "--output-format",
        "json",
        "--model",
        "claude-haiku-5-5"
      ]
    }
  }
}
