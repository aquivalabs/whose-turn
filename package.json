{
  "name": "whose-turn",
  "version": "1.0.0-alpha.6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aquivalabs/whose-turn.git"
  },
  "files": [
    "server.mjs",
    "lib/",
    "connectors/",
    "dist/",
    "install.sh",
    "launch.sh",
    "open.sh",
    "config.example.json",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "description": "Local monitor that answers what is waiting on you across Jira, GitHub and Linear.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "start": "node server.mjs",
    "dev": "WHOSE_TURN_DATA=.users-files/dev WHOSE_TURN_PORT=8766 node server.mjs",
    "test": "node --experimental-strip-types --test \"test/**/*.test.mjs\"",
    "dev:web": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json",
    "lint": "eslint web/src lib connectors server.mjs test",
    "lint:style": "stylelint \"web/src/**/*.{vue,css}\"",
    "format": "prettier --write web/src",
    "check": "npm run typecheck && npm run lint && npm run lint:style && npm test && npm run test:web",
    "test:web": "vitest run"
  },
  "bin": {
    "whose-turn": "server.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/vue": "8.1.0",
    "@types/node": "22.19.19",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "2.5.1",
    "@vueuse/core": "15.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "21.0.4",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "^6.0.0",
    "vitest": "5.1.0",
    "vue": "^3.5.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  }
}
