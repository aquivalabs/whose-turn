{
  "$schema": "./docs.config.schema.json",
  "schemaVersion": "1",
  "layers": {
    "adr": {
      "root": "docs/adr/",
      "index": "README.md",
      "requiredFields": [
        "Status",
        "Context",
        "Decision",
        "Consequences"
      ],
      "numbered": true
    },
    "mechanisms": "docs/mechanisms/",
    "frozen": "docs/plans/"
  },
  "mechanisms": [
    {
      "id": "species-dsl",
      "paths": [
        "web/src/species/base/*.json",
        "web/src/lib/species.js",
        "web/src/lib/silhouette.js",
        "web/src/lib/random.js",
        "web/src/backdrop.js"
      ],
      "doc": "docs/mechanisms/species-dsl.md"
    }
  ],
  "acknowledgedEmptyMechanisms": true,
  "surfaceRules": {
    "lineCap": 200,
    "paths": [
      "AGENTS.md"
    ]
  },
  "_comment": "No mechanism is declared yet on purpose: server.py is being rewritten in Node (RMA-80). Declare connectors, rules and workspace config as mechanisms when that lands."
}
