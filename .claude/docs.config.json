{
  "$schema": "./docs.config.schema.json",
  "schemaVersion": "1",
  "layers": {
    "adr": {
      "root": "docs/adr/",
      "index": "README.md",
      "requiredFields": [
        "Status",
        "Context",
        "Decision",
        "Consequences"
      ],
      "numbered": true
    },
    "mechanisms": "docs/mechanisms/",
    "frozen": "docs/plans/"
  },
  "mechanisms": [
    {
      "id": "species-dsl",
      "paths": [
        "web/src/species/base/*.json",
        "web/src/lib/species.ts",
        "web/src/lib/silhouette.ts",
        "web/src/lib/random.ts",
        "web/src/backdrop.ts"
      ],
      "doc": "docs/mechanisms/species-dsl.md"
    },
    {
      "id": "rules-table",
      "paths": [
        "lib/rules.mjs",
        "lib/facts.mjs",
        "lib/table.mjs",
        "lib/default-table.mjs"
      ],
      "doc": "docs/mechanisms/rules-table.md"
    }
  ],
  "surfaceRules": {
    "lineCap": 200,
    "paths": [
      "AGENTS.md"
    ]
  },
  "_comment": "Mechanisms are declared as they stabilise (AGENTS.md, Gates). Next candidates: the connector contract and the workspace config."
}
