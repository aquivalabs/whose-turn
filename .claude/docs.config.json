{
  "$schema": "./docs.config.schema.json",
  "schemaVersion": "1",
  "layers": {
    "adr": {
      "root": "docs/adr/",
      "index": "README.md",
      "requiredFields": [
        "Status",
        "Context",
        "Decision",
        "Consequences"
      ],
      "numbered": true
    },
    "mechanisms": "docs/mechanisms/",
    "frozen": "docs/plans/"
  },
  "mechanisms": [
    {
      "id": "species-dsl",
      "paths": [
        "web/src/species/base/*.json",
        "web/src/lib/species.ts",
        "web/src/lib/silhouette.ts",
        "web/src/lib/random.ts",
        "web/src/backdrop.ts"
      ],
      "doc": "docs/mechanisms/species-dsl.md"
    },
    {
      "id": "rules-table",
      "paths": [
        "lib/rules.mjs",
        "lib/facts.mjs",
        "lib/table.mjs",
        "lib/default-table.mjs"
      ],
      "doc": "docs/mechanisms/rules-table.md"
    },
    {
      "id": "connector-contract",
      "paths": [
        "lib/contract.mjs",
        "lib/adapter.mjs",
        "types/connector.d.ts",
        "connectors/index.mjs",
        "connectors/module.mjs",
        "connectors/file.mjs",
        "scripts/check-adapter.mjs"
      ],
      "doc": "docs/mechanisms/connector-contract.md"
    },
    {
      "id": "your-move",
      "paths": [
        "web/src/lib/moves.ts",
        "lib/backoff.mjs"
      ],
      "doc": "docs/mechanisms/your-move.md"
    },
    {
      "id": "tooltips",
      "paths": [
        "web/src/lib/tooltips.ts"
      ],
      "doc": "docs/mechanisms/tooltips.md"
    },
    {
      "id": "motion",
      "paths": [
        "web/src/motion.ts",
        "web/src/motion-features.ts",
        "web/src/features/your-move/RecentlyDone.vue",
        "web/src/ui/Island.vue",
        "web/src/ui/Modal.vue",
        "web/src/ui/Swap.vue",
        "web/src/test-motion.ts",
        "web/src/styles/tokens.css",
        "web/src/ui/RowScroll.vue"
      ],
      "doc": "docs/mechanisms/motion.md"
    },
    {
      "id": "i18n",
      "paths": [
        "web/src/i18n/index.ts",
        "web/src/i18n/en/index.ts"
      ],
      "doc": "docs/mechanisms/i18n.md"
    }
  ],
  "surfaceRules": {
    "lineCap": 200,
    "paths": [
      "AGENTS.md"
    ]
  },
  "_comment": "Mechanisms are declared as they stabilise (AGENTS.md, Gates). Next candidate: the workspace config. The built-in connectors join connector-contract when they export the contract (RMA-95, stage 1)."
}
