{
  "extraKnownMarketplaces": {
    "bladeforge": {
      "source": {
        "source": "github",
        "repo": "aquivalabs/BladeForge"
      }
    }
  },
  "enabledPlugins": {
    "docs@bladeforge": true,
    "review@bladeforge": true,
    "review-workflow@bladeforge": true,
    "tests@bladeforge": true,
    "cicero@bladeforge": true,
    "git@bladeforge": true,
    "meta@bladeforge": true,
    "error@bladeforge": true,
    "frontend-js@bladeforge": true,
    "critique@bladeforge": true,
    "no-code-prose@bladeforge": true,
    "cerberus@bladeforge": true,
    "frontend@bladeforge": true,
    "frontend-css@bladeforge": true,
    "frontend-vue@bladeforge": true
  },
  "includeCoAuthoredBy": false,
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/language-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Language guard..."
          }
        ]
      }
    ]
  }
}
